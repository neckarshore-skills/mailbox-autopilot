{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "disableAllHooks": true,
  "enabledPlugins": {
    "cc-plugin-agents-md@builtin": false,
    "cc-plugin-plugin-authoring@builtin": false,
    "cc-plugin-privacy@builtin": false
  },
  "permissions": {
    "deny": [
      "Agent",
      "Bash",
      "CronCreate",
      "CronDelete",
      "CronList",
      "Edit",
      "EnterWorktree",
      "ExitWorktree",
      "Glob",
      "Grep",
      "ListAgents",
      "Monitor",
      "NotebookEdit",
      "Read",
      "ReportFindings",
      "ScheduleWakeup",
      "SendMessage",
      "Task",
      "TaskStop",
      "ToolSearch",
      "WebFetch",
      "WebSearch",
      "Workflow",
      "Write"
    ]
  }
}
